# 跨平台换行约定：仓库统一存 LF，Windows 检出按需转换
* text=auto

# 服务器脚本/配置必须是 LF，避免在 Windows 上编辑后带到 Linux 无法执行
*.sh text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf
*.conf text eol=lf
*.ini text eol=lf
*.md text eol=lf
*.txt text eol=lf

# 二进制/生成产物不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.gz binary
*.zip binary
