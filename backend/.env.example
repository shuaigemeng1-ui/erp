# ------------------------------------------------------------------ 基础
APP_NAME=ERP
APP_ENV=development
API_PREFIX=/api/v1
DEBUG=true
LOG_LEVEL=INFO
# 前端站点源，用于 Cookie 会话来源校验（开发时前端 5173）
APP_ORIGIN=http://127.0.0.1:5173

# ------------------------------------------------------------------ 安全
# 生产必须替换：至少 32 位随机字符串
SECRET_KEY=dev-only-secret-key-change-me
# 可选：32 字节 AES 密钥的 base64；留空则由 SECRET_KEY 派生（仅开发）
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=vs_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=vs_csrf
SESSION_TTL_SECONDS=43200

# ------------------------------------------------------------------ 中心库
CENTER_DATABASE_URL=mysql+pymysql://ventasync:ventasync@127.0.0.1:3306/ventasync_center?charset=utf8mb4
# 建库 / 建号 / 迁移使用独立运维身份（生产必须与运行账号分开）
PROVISIONER_DATABASE_URL=

# ------------------------------------------------------------------ 租户库
TENANT_DB_HOST=127.0.0.1
TENANT_DB_PORT=3306
TENANT_DB_PREFIX=vs_tenant_
TENANT_DB_USER_PREFIX=vs_t_
TENANT_POOL_SIZE=5
TENANT_MAX_OVERFLOW=5
TENANT_POOL_RECYCLE_SECONDS=1800
TENANT_ENGINE_CACHE_SIZE=64

# ------------------------------------------------------------------ Redis
# 缓存/会话
CACHE_REDIS_URL=redis://127.0.0.1:6379/0
# 任务队列（与缓存分开）
QUEUE_REDIS_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# ------------------------------------------------------------------ HTTP
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# ------------------------------------------------------------------ 对象存储（S3 兼容）
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
FILE_PUBLIC_BASE_URL=

# ------------------------------------------------------------------ Shopee（应用凭据存中心库，由平台管理员在后台配置）
SHOPEE_API_BASE=https://partner.shopeemobile.com
SHOPEE_AUTH_BASE=https://partner.shopeemobile.com
SHOPEE_AUTH_REDIRECT_URL=
SHOPEE_HTTP_TIMEOUT_SECONDS=20
SHOPEE_HTTP_MAX_RETRIES=3

# ------------------------------------------------------------------ 首次初始化
# 仅由 `python -m app.cli platform-init` 使用，首版不开放公共管理员注册
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=ChangeMe-123456
BOOTSTRAP_PLATFORM_ADMIN_NAME=平台管理员

# ------------------------------------------------------------------ 定时任务
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
OUTBOX_BATCH_SIZE=100
SYNC_RUN_STALE_MINUTES=30
