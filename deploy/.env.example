# =============================================================================
# VentaSync 部署环境变量模板（Docker Compose）
#
# 用法：
#   cp deploy/.env.example deploy/.env
#   # 修改所有 change-me 值；生产必须使用强随机值
#   docker compose -f deploy/docker-compose.yml --env-file deploy/.env config -q
#
# 注意：
# * 本文件只作为模板提交仓库，真实的 deploy/.env 不得提交。
# * Compose 会自动读取 deploy/.env（与 docker-compose.yml 同目录），
#   因此也可省略 --env-file 参数。
# * 值中避免使用未转义的 `$`、`#`、空格；密码建议只用字母、数字和 -_。
# * bootstrap 管理员密码仅首次初始化使用，初始化完成后建议清空。
# =============================================================================

# ------------------------------------------------------------------ 项目
# Compose 项目名，决定容器名与数据卷名
COMPOSE_PROJECT_NAME=ventasync
# 镜像标签（发布时改成版本号/提交号，便于回滚）
APP_IMAGE_TAG=local

# ------------------------------------------------------------------ 入口
# 宿主机 HTTP 端口，Nginx 监听容器的 80
HTTP_PORT=8080
# 对外访问地址（同源 Cookie 会话、CSRF/Origin 校验、Shopee 回调都依赖它）
APP_ORIGIN=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:8080
# 前端构建使用的 npm registry
NPM_REGISTRY=https://registry.npmmirror.com

# ------------------------------------------------------------------ 应用
APP_NAME=VentaSync
# production / test / development
APP_ENV=production
API_PREFIX=/api/v1
DEBUG=false
LOG_LEVEL=INFO
# 至少 32 位随机字符串：openssl rand -base64 48
SECRET_KEY=please-replace-with-a-random-secret-at-least-32-bytes
# 可选：32 字节 AES 密钥的 base64；留空则由 SECRET_KEY 派生（生产建议显式配置）
# 生成：openssl rand -base64 32
ENCRYPTION_KEY=
SESSION_COOKIE_NAME=vs_session
# HTTP 部署为 false；启用 HTTPS 后必须改为 true
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
CSRF_COOKIE_NAME=vs_csrf
SESSION_TTL_SECONDS=43200
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=200

# ------------------------------------------------------------------ MySQL
# root 仅用于建库/建号/迁移（单机部署简化）；生产请改用最小权限运维账号
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=300
# 中心库
CENTER_DB_NAME=ventasync_center
CENTER_DB_USER=ventasync
CENTER_DB_PASSWORD=change-me-center-password
# 租户库命名（开通任务按前缀生成库名与账号）
TENANT_DB_PREFIX=vs_tenant_
TENANT_DB_USER_PREFIX=vs_t_
# 每个租户连接池（总连接数 ≈ 租户数 × (POOL_SIZE + MAX_OVERFLOW)，注意与 MYSQL_MAX_CONNECTIONS 匹配）
TENANT_POOL_SIZE=5
TENANT_MAX_OVERFLOW=5
TENANT_POOL_RECYCLE_SECONDS=1800
TENANT_ENGINE_CACHE_SIZE=64

# ------------------------------------------------------------------ Redis
# 缓存/会话实例（允许 LRU 淘汰）
CACHE_REDIS_MAXMEMORY=256mb
# 队列/结果实例（noeviction + AOF，禁止淘汰待执行任务）
QUEUE_REDIS_MAXMEMORY=512mb

# ------------------------------------------------------------------ Celery
CELERY_CONCURRENCY=4
CELERY_LOG_LEVEL=INFO
OUTBOX_DISPATCH_INTERVAL_SECONDS=15
OUTBOX_BATCH_SIZE=100
SYNC_RUN_STALE_MINUTES=30

# ------------------------------------------------------------------ 对象存储（S3 兼容，可选）
S3_ENDPOINT=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=true
FILE_PUBLIC_BASE_URL=

# ------------------------------------------------------------------ Shopee
SHOPEE_API_BASE=https://partner.shopeemobile.com
SHOPEE_AUTH_BASE=https://partner.shopeemobile.com
# 必须与平台应用后台登记的回调地址一致（指向 Nginx → /api/v1/integrations/shopee/oauth/callback）
SHOPEE_AUTH_REDIRECT_URL=http://localhost:8080/api/v1/integrations/shopee/oauth/callback
SHOPEE_HTTP_TIMEOUT_SECONDS=20
SHOPEE_HTTP_MAX_RETRIES=3

# ------------------------------------------------------------------ 首次平台管理员（仅 platform-init 使用）
BOOTSTRAP_PLATFORM_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=ChangeMe-123456
BOOTSTRAP_PLATFORM_ADMIN_NAME=平台管理员

# ------------------------------------------------------------------ 备份
# backup.sh 默认输出目录（相对仓库根目录的 deploy/backups）
BACKUP_DIR=backups
# 备份保留天数，0 表示不自动清理
BACKUP_RETENTION_DAYS=14
