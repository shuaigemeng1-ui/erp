# 独立网关环境变量示例。复制为 .env，chmod 600。
# 仅在网关主机保存；不要复制到租户或管理中心。

GATEWAY_DB_PATH=/data/gateway.db
GATEWAY_PUBLIC_URL=https://gateway.example.com

# 32+ 随机字符，仅网关持有。生成：openssl rand -base64 48
GATEWAY_SECRET_KEY=CHANGE_ME_RANDOM_32_BYTES_OR_MORE

# 平台管理令牌，仅平台管理员使用；租户不得持有。
GATEWAY_ADMIN_TOKEN=CHANGE_ME_ADMIN_TOKEN

GATEWAY_CHANNELS=shopee,tiktok
GATEWAY_ENVIRONMENTS=production,test
GATEWAY_INSTANCE_AUTH_ENABLED=true
GATEWAY_LEGACY_TENANT_ADMIN_ENABLED=true
GATEWAY_OAUTH_STATE_TTL_SECONDS=600
GATEWAY_REFRESH_LOCK_TTL_SECONDS=120
GATEWAY_RATE_LIMIT_PER_MINUTE=120
GATEWAY_LOG_LEVEL=INFO

# TikTok Webhook 唯一入口：Gateway 验签后转发给租户 relay。
# 必须与租户环境变量 GATEWAY_WEBHOOK_RELAY_SECRET 保持一致。
GATEWAY_WEBHOOK_RELAY_SECRET=CHANGE_ME_RANDOM_32_BYTES_OR_MORE
GATEWAY_WEBHOOK_DISPATCH_ENABLED=true
