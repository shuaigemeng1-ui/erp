# 网关 SQLite 备份 sidecar 配置（docker-compose.backup.yml）
# 用法：--env-file /opt/erp-gateway/backup.env；不要提交真实路径以外的敏感值。
# 本文件不包含渠道密钥/实例令牌；加密密钥只在 GATEWAY_BACKUP_KEY_DIR 中（权限 600）。

# 仓库 scripts/ 目录（相对 compose 文件 deploy/gateway）
GATEWAY_BACKUP_SCRIPT_DIR=../../scripts

# 本地私有备份目录（必须与 /data 不同盘/不同目录；建议 700）
GATEWAY_BACKUP_ROOT=/opt/erp-gateway/backups
# 加密密钥目录；首次在宿主机生成（只在宿主机保留，勿与备份放同一块盘）：
#   install -d -m 700 /opt/erp-gateway/keys
#   python3 /opt/erp/scripts/gateway_backup.py snapshot \
#     --key-file /opt/erp-gateway/keys/backup.key --init-key --backup-root /tmp/unused
# 将 key 文件权限保持 600，并复制到独立密钥管理系统。
GATEWAY_BACKUP_KEY_DIR=/opt/erp-gateway/keys

# 异机/独立私有目录（sidecar 内使用 local 模式；建议挂载 NFS/远端同步盘，
# 或改由宿主机 rsync 模式同步到另一台机器）。
GATEWAY_BACKUP_OFFSITE_DIR=/opt/erp-gateway/offsite

# 快照频率与保留：15 分钟一份；最近 24h 全保留，更早 30 天每天一份。
GATEWAY_BACKUP_INTERVAL_SECONDS=900
GATEWAY_BACKUP_RECENT_HOURS=24
GATEWAY_BACKUP_DAILY_DAYS=30

# 事件保留策略（由 gateway_backup.py retention 执行，默认 dry-run）
GATEWAY_RETENTION_PAYLOAD_DAYS=7
GATEWAY_RETENTION_DEDUP_DAYS=30

# 主网关镜像/数据卷名（标准 deploy/gateway 为 erp_gateway_data；实际生产如
# erp-gateway-v2 请按容器实际卷名覆盖）
# GATEWAY_IMAGE_TAG=latest
# GATEWAY_DATA_VOLUME=erp_gateway_data
# 可选：GATEWAY_BACKUP_DISK_QUOTA_BYTES=5368709120
