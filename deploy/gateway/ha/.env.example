# 双实例 Gateway HA 集成/演练环境变量（不要提交 .env）
COMPOSE_PROJECT_NAME=erp-gateway-ha

GATEWAY_IMAGE_TAG=latest
GATEWAY_HA_HTTP_PORT=8088
GATEWAY_PUBLIC_URL=https://gateway.example.com

# 与旧 SQLite Gateway 保持完全相同，否则 payload_cipher/channel secret 无法解密。
GATEWAY_SECRET_KEY=
GATEWAY_ADMIN_TOKEN=
GATEWAY_WEBHOOK_RELAY_SECRET=

GATEWAY_CHANNELS=shopee,tiktok
GATEWAY_ENVIRONMENTS=production,test

# PostgreSQL（本地演示；生产指向托管 HA 端点）
POSTGRES_PASSWORD=
# 生产可改为：GATEWAY_DATABASE_URL=postgresql://gateway:...@pg-ha.internal:5432/gateway
# 注意：compose 默认用 postgres 服务；生产请移除 postgres 服务并显式设置该 URL。
