# =============================================================================
# 第二独立租户实例配置模板（批次 4）
#
# 使用：
#   1) 复制为 /opt/ventasync/deploy/.env（权限 600，root:root），禁止提交到 Git；
#   2) 用 deploy/scripts/tenant-onboarding/config.sh --render 生成，或手工替换所有占位符；
#   3) config.sh --check 校验通过后才允许 install/migrate。
#
# 关键约束：
#   * 一个实例只服务一个租户：TENANT_ID / INSTANCE_ID / Worker 绑定必须一致；
#   * 中心平台接口在该实例不可用（deployment_mode=tenant，/platform 返回 404）；
#   * 禁止照抄中心实例的数据库名、Redis key 前缀或端口。
# =============================================================================

# ------------------------------------------------------------------ 版本与项目
COMPOSE_PROJECT_NAME=ventasync-tenant-__SET_ME__
APP_IMAGE_TAG=__SET_ME__
APP_ENV=production
LOG_LEVEL=INFO
HTTP_BIND=127.0.0.1
HTTP_PORT=8081

# ------------------------------------------------------------------ 部署形态与固定绑定
DEPLOYMENT_MODE=tenant
TENANT_ID=__SET_ME__
INSTANCE_ID=__SET_ME__
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAME_SITE=lax

# 后台任务：Worker/Scheduler/Outbox 统一从进程环境读取，任务 payload 不可覆盖
ERP_WORKER_TENANT_ID=__SET_ME__
ERP_WORKER_INSTANCE_ID=__SET_ME__
ERP_WORKER_STRICT_BINDING=true

# ------------------------------------------------------------------ 数据库（本实例 MySQL）
# 独立租户实例同时保存中心库（账号/成员路由）与租户库；库名不得与中心生产实例混用
MYSQL_ROOT_PASSWORD=__SET_ME__
CENTER_DB_NAME=ventasync_center
CENTER_DB_USER=ventasync
CENTER_DB_PASSWORD=__SET_ME__
TENANT_DB_PREFIX=vs_tenant_
TENANT_DB_HOST=mysql
TENANT_DB_PORT=3306
MYSQL_INNODB_BUFFER_POOL_SIZE=256M
MYSQL_MAX_CONNECTIONS=200

# ------------------------------------------------------------------ Redis（本实例独立队列，禁止连中心 Redis）
CACHE_REDIS_MAXMEMORY=256mb
QUEUE_REDIS_MAXMEMORY=512mb
CELERY_LOG_LEVEL=INFO
CELERY_CONCURRENCY=1

# ------------------------------------------------------------------ 域名 / 证书
# 由宿主机 Caddy/Nginx 终止 TLS；示例见 deploy/caddy/Caddyfile.example
# 证书可用 DNS-01 自动签发；APP_ORIGIN 必须与浏览器访问地址完全一致（含 https）
APP_ORIGIN=https://__SET_ME__
CORS_ALLOW_ORIGINS=https://__SET_ME__
TRUSTED_HOSTS=__SET_ME__

# ------------------------------------------------------------------ 渠道 OAuth 回调（每个实例独立登记）
SHOPEE_AUTH_BASE=https://partner.shopeemobile.com
SHOPEE_AUTH_REDIRECT_URL=https://__SET_ME__/api/v1/integrations/shopee/oauth/callback
TIKTOK_AUTH_BASE=https://auth.tiktok-shops.com
TIKTOK_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_AUTH_REDIRECT_URL=https://__SET_ME__/api/v1/integrations/tiktok/oauth/callback

# ------------------------------------------------------------------ 独立集成网关（如启用）
GATEWAY_BASE_URL=__SET_ME_OR_EMPTY__
GATEWAY_ADMIN_TOKEN=
GATEWAY_CHANNEL_CONFIG=false

# ------------------------------------------------------------------ 备份（批次 3）
BACKUP_ROOT=/var/lib/ventasync-backups
BACKUP_GROUP=erp-agent
BACKUP_RETENTION_DAYS=30
BACKUP_INSTANCE_ID=__SET_ME__
BACKUP_ENCRYPTION_KEY_FILE=/etc/ventasync/backup.key
BACKUP_OFFSITE_MODE=none
BACKUP_OFFSITE_DIR=/var/lib/ventasync-backups/offsite
BACKUP_RECORD=1

# ------------------------------------------------------------------ 对象存储 / 图片（如租户使用本地图片卷则留空）
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_FORCE_PATH_STYLE=true
FILE_PUBLIC_BASE_URL=

# ------------------------------------------------------------------ 低配资源限制（2C2G 单机）
MYSQL_MEM_LIMIT=700m
CACHE_REDIS_MEM_LIMIT=96m
QUEUE_REDIS_MEM_LIMIT=160m
API_MEM_LIMIT=420m
WORKER_MEM_LIMIT=420m
SCHEDULER_MEM_LIMIT=160m
NGINX_MEM_LIMIT=64m
