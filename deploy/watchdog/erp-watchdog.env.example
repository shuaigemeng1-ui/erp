# ERP 管理中心 watchdog 环境变量（复制到 /etc/erp-watchdog.env 并 chmod 600）
# 该配置与中心数据库、中心 email_profiles 完全独立；建议使用独立发信邮箱。

# 必填：管理中心入口地址（不要带路径）
ERP_WATCHDOG_TARGET=https://erp.example.com
# 探测端点：name=path，逗号分隔；默认 healthz + 业务 runtime（任一失败即失败）
ERP_WATCHDOG_ENDPOINTS=/healthz,/api/v1/runtime
# 探测周期（秒，最小 15）
ERP_WATCHDOG_INTERVAL=60
# 连续失败达到该次数才告警（避免抖动）
ERP_WATCHDOG_FAIL_THRESHOLD=3
# 单次 HTTP 探测超时（秒）
ERP_WATCHDOG_TIMEOUT=10
# 未恢复期间重复提醒间隔（秒）
ERP_WATCHDOG_COOLDOWN_SECONDS=1800
# 探活成功但延迟超过该值时告警（毫秒；0=关闭）
ERP_WATCHDOG_LATENCY_WARN_MS=0
# 恢复后是否发恢复邮件
ERP_WATCHDOG_RECOVERY_NOTIFY=true
# 状态文件（systemd 已授予 /var/lib/erp-watchdog 写权限）
ERP_WATCHDOG_STATE=/var/lib/erp-watchdog/state.json
# 只打印不发送（联调/演练）
ERP_WATCHDOG_DRY_RUN=0

# ------------------------------------------------------------------ 独立 SMTP
ERP_WATCHDOG_SMTP_HOST=smtp.example.com
# ssl=465，starttls=587，none=25（仅内网）
ERP_WATCHDOG_SMTP_SECURITY=ssl
ERP_WATCHDOG_SMTP_PORT=465
ERP_WATCHDOG_SMTP_USER=watchdog@example.com
ERP_WATCHDOG_SMTP_PASSWORD=change-me
ERP_WATCHDOG_SMTP_FROM=watchdog@example.com
ERP_WATCHDOG_SMTP_TO=ops@example.com,sre@example.com
ERP_WATCHDOG_SMTP_TIMEOUT=15
ERP_WATCHDOG_MAIL_SUBJECT_PREFIX=[ERP]
