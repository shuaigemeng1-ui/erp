# syntax=docker/dockerfile:1.7
# ---------------------------------------------------------------------------
# 前端运行时镜像（服务器无法/不便执行 Node 构建时使用）
#
# 前置：在本地或 CI 执行 `cd frontend && npm run build`，把 dist 上传到服务器。
# 构建（在 deploy/ 目录执行）：
#   docker build -f ../frontend/Dockerfile.runtime -t ventasync-frontend:runtime ../frontend
#
# 站点配置由 Compose 挂载 deploy/nginx/nginx.conf 提供（/api 反代 + SPA 回退）。
# 正式的可复现构建仍使用 frontend/Dockerfile（多阶段 node 构建）。
# ---------------------------------------------------------------------------
FROM nginx:alpine

# 静态产物（Vite 默认输出 dist/）
COPY dist /usr/share/nginx/html

# 删除默认站点；实际站点由挂载的 /etc/nginx/nginx.conf 提供
RUN rm -f /etc/nginx/conf.d/default.conf

EXPOSE 80
