[Unit]
Description=ERP management center watchdog
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/erp-watchdog.env
ExecStart=/usr/bin/python3 /opt/erp-watchdog/erp_watchdog.py
Restart=always
RestartSec=10
User=erp-watchdog
Group=erp-watchdog
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
